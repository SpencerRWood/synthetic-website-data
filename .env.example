# Required for Alembic migrations and PostgreSQL CSV loading.
# Replace every placeholder before use; do not commit real credentials.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/synthetic_website_data

# Optional generation paths. CLI flags override these values.
SYNTHETIC_WEBSITE_DATA_CONFIG=configs/default.yaml
SYNTHETIC_WEBSITE_DATA_OUTPUT_DIR=data

# Optional Dagster metadata PostgreSQL settings for a remote code location.
# Use a hostname reachable by both the Dagster control plane and this code
# location; do not use a container-only hostname.
DAGSTER_POSTGRES_HOST=replace-with-dagster-postgres-host
DAGSTER_POSTGRES_PORT=5432
DAGSTER_POSTGRES_DB=dagster
DAGSTER_POSTGRES_USER=dagster
DAGSTER_POSTGRES_PASSWORD=
DAGSTER_POSTGRES_URL=postgresql://dagster:replace_me@replace-with-dagster-postgres-host:5432/dagster

# Local path to the sibling dbt checkout used by the Dagster code location.
# The Dagster container sets this internally to /app/synthetic-website-dbt.
SYNTHETIC_WEBSITE_DBT_PROJECT_DIR=../synthetic-website-dbt

# Optional: used only by semantic-release publishing workflows.
GITHUB_TOKEN=
